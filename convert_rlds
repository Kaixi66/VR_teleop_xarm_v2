#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# USER SETTINGS
###############################################################################

CONVERT_PRESS_BUTTONS="true"
CONVERT_PLACE_CORN="true"
OVERWRITE_EXISTING="false"

# These values match the earlier setting1/setting2 no-op training pipeline.
NOOP_TRANSLATION_THRESHOLD_CM="0.02"
NOOP_ROTATION_THRESHOLD_RAD="0.002"
GRIPPER_RAW_THRESHOLD="425"

###############################################################################

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${RLDS_PYTHON:-${HOME}/miniforge3/envs/openvla-oft/bin/python}"

if [[ ! -x "${PYTHON}" ]]; then
    echo "Missing OpenVLA-OFT Python: ${PYTHON}" >&2
    exit 1
fi

convert_one() {
    local dataset_name="$1"
    local output_name="$2"
    local -a command=(
        "${PYTHON}" -m vrtool.raw_to_rlds
        --dataset-root "${SCRIPT_DIR}/data/${dataset_name}"
        --output-root "${SCRIPT_DIR}/rlds_noop/${output_name}"
        --noop-pos-threshold-cm "${NOOP_TRANSLATION_THRESHOLD_CM}"
        --noop-rot-threshold-rad "${NOOP_ROTATION_THRESHOLD_RAD}"
        --gripper-threshold "${GRIPPER_RAW_THRESHOLD}"
    )
    if [[ "${OVERWRITE_EXISTING}" == "true" ]]; then
        command+=(--overwrite)
    fi
    echo "Converting ${dataset_name} -> rlds_noop/${output_name}"
    (cd "${SCRIPT_DIR}" && "${command[@]}")
}

if [[ "${CONVERT_PRESS_BUTTONS}" == "true" ]]; then
    convert_one "Press_buttons" "press_buttons"
fi

if [[ "${CONVERT_PLACE_CORN}" == "true" ]]; then
    convert_one "Place_corn_in_bowl" "place_corn_in_bowl"
fi

echo "RLDS conversion and validation finished. Raw data was not changed."
