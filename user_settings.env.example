# Copy this file to user_settings.env. The copied file is ignored by Git.
# Values use Bash syntax; keep quotes around text containing spaces.

DATASET_NAME="example_task"
TASK_TEXT="Describe the task in one English sentence."
MODE="mock"  # Change to "real" only after the mock test passes.
USE_HOTSPOT="true"

# At least 8 characters. Leave empty for a hidden interactive prompt.
# Never commit a real hotspot password.
HOTSPOT_PASSWORD=""
